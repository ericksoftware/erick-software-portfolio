# =========================================================
# Variables de entorno y secretos
# =========================================================

.env
.env.*
!.env.example

backend/.env
frontend/.env

# =========================================================
# Python / Django
# =========================================================

__pycache__/
*.py[cod]
*$py.class
*.so

backend/venv/
backend/.venv/
venv/
.venv/

*.sqlite3
db.sqlite3

.pytest_cache/
.coverage
htmlcov/

# Archivos generados por Django
backend/staticfiles/

# Archivos subidos desde el administrador
backend/media/*
!backend/media/.gitkeep

# Logs
*.log
logs/

# =========================================================
# Node / React / Vite
# =========================================================

frontend/node_modules/
frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# IDE y sistema operativo
# =========================================================

.vscode/
.idea/

.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# Archivos temporales
# =========================================================

*.tmp
*.temp
*.bak
*.swp
~$*